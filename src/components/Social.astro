---
import { siFacebook, siInstagram, siTwitch, siYoutube } from 'simple-icons';

// Remplace les "#" par les vrais liens de la team.
const reseaux = [
  { nom: 'Facebook', url: 'https://www.facebook.com/profile.php?id=61587195485081', icone: siFacebook },
  { nom: 'Instagram', url: 'https://www.instagram.com/ascendiaracingteam/', icone: siInstagram },
  { nom: 'Twitch', url: 'https://www.twitch.tv/ascendiatv', icone: siTwitch },
  { nom: 'YouTube', url: 'https://www.youtube.com/@AscendiaRacingTeamTV', icone: siYoutube },
];
---
<ul class="social">
  {reseaux.map((r) => (
    <li>
      <a href={r.url} target="_blank" rel="noopener noreferrer" aria-label={`Ascendia Racing Team sur ${r.nom}`}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d={r.icone.path} fill="currentColor" />
        </svg>
      </a>
    </li>
  ))}
</ul>

<style>
  .social { display: flex; gap: 8px; list-style: none; margin: 0; padding: 0; }
  a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: color .2s, background .2s, box-shadow .2s;
  }
  a:hover {
    color: var(--accent-ink);
    background: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
  }
</style>
