---
// Mentions légales : bouton dans le footer qui ouvre une fenêtre (élément <dialog> natif :
// accessible au clavier, fermeture par Échap, focus gardé dans la fenêtre).
const discord = 'https://discord.gg/fwKemzCC7J';
const instagram = 'https://www.instagram.com/ascendiaracingteam/';
---
<button type="button" class="ml-ouvrir" data-ml-ouvrir aria-haspopup="dialog" aria-controls="mentions-legales">
  Mentions légales
</button>

<dialog id="mentions-legales" class="ml" aria-labelledby="ml-titre">
  <div class="ml-tete">
    <h2 id="ml-titre">Mentions <em>légales</em></h2>
    <button type="button" class="ml-fermer" data-ml-fermer aria-label="Fermer les mentions légales">
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2.4" fill="none" /></svg>
    </button>
  </div>

  <div class="ml-corps">
    <h3>Éditeur du site</h3>
    <p>
      Le présent site, accessible à l'adresse <a href="https://ascendia-racing.vercel.app">ascendia-racing.vercel.app</a>,
      est édité par <strong>Ascendia Racing Team</strong>, association en formation, inscrite sous le numéro d'entreprise <strong>BE 1040.881.660</strong>, dont le siège est situé <strong>Rempart du Vieux Cimetière n°46, 7060 Soignies (Belgique)</strong>, représentée par <strong>Monsieur Damien Wuilmus</strong> en sa qualité de Fondateur et Administrateur.
    </p>
    <p>Directeur de la publication : Damien Wuilmus.</p>
    <p>
      Contact : <a href="mailto:ascendia.racing@gmail.com">ascendia.racing@gmail.com</a>, ou via notre <a href={discord} target="_blank" rel="noopener noreferrer">serveur Discord</a> ou notre <a href={instagram} target="_blank" rel="noopener noreferrer">compte Instagram</a>.
    </p>

    <h3>Représentation juridique</h3>
    <p>
      Pour les questions d'ordre juridique, Ascendia Racing Team est représentée par <strong>Xerius</strong> (<a href="https://www.xerius.be" target="_blank" rel="noopener noreferrer">www.xerius.be</a>).
    </p>

    <h3>Hébergement</h3>
    <p>
      Vercel Inc.<br />
      440 N Barranca Ave #4133, Covina, CA 91723, États-Unis<br />
      Site web : <a href="https://vercel.com" target="_blank" rel="noopener noreferrer">vercel.com</a>
    </p>

    <h3>Données personnelles</h3>
    <p>
      Ce site ne comporte aucun formulaire et ne collecte directement aucune donnée personnelle.
      L'hébergeur peut enregistrer des données techniques de connexion (adresse IP, navigateur) à des fins
      de sécurité et de bon fonctionnement. Les lecteurs vidéo intégrés (Twitch) sont fournis par des services
      tiers, soumis à leurs propres politiques de confidentialité.
    </p>
    <p>
      Conformément au Règlement général sur la protection des données (RGPD, règlement UE 2016/679),
      vous disposez d'un droit d'accès, de rectification, d'effacement et d'opposition concernant vos données,
      que vous pouvez exercer en nous contactant. Vous pouvez également introduire une réclamation auprès de
      l'Autorité de protection des données (<a href="https://www.autoriteprotectiondonnees.be" target="_blank" rel="noopener noreferrer">autoriteprotectiondonnees.be</a>).
    </p>

    <h3>Clause de non-responsabilité</h3>
    <p>
      Ce site peut proposer des liens vers d'autres sites (réseaux sociaux, partenaires, plateformes de streaming).
      Ces pages ne font pas partie du site et n'engagent pas la responsabilité du directeur de la publication
      quant à leur contenu.
    </p>

    <h3>Droits d'auteur &amp; marques</h3>
    <p>
      La reproduction de tout ou partie de ce site sur un support électronique quel qu'il soit est formellement
      interdite, sauf autorisation expresse du directeur de la publication.
    </p>
    <p>
      Toutes les marques citées appartiennent à leurs propriétaires respectifs, notamment iRacing et
      Le Mans Ultimate. Les logos des partenaires et sponsors sont la propriété de leur marque respective.
    </p>
  </div>
</dialog>

<script>
  const dialogue = document.getElementById('mentions-legales') as HTMLDialogElement | null;
  document.querySelectorAll('[data-ml-ouvrir]').forEach((b) => b.addEventListener('click', () => dialogue?.showModal()));
  dialogue?.querySelector('[data-ml-fermer]')?.addEventListener('click', () => dialogue.close());
  // clic sur le fond sombre (en dehors de la fenêtre) → ferme
  dialogue?.addEventListener('click', (e) => { if (e.target === dialogue) dialogue.close(); });
</script>

<style>
  .ml-ouvrir {
    all: unset;
    display: inline-block;
    margin-top: 10px;
    color: var(--muted);
    font-size: .9rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    transition: color .2s;
  }
  .ml-ouvrir:hover { color: var(--accent); }
  .ml-ouvrir:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .ml {
    width: min(760px, calc(100vw - 32px));
    max-height: min(84vh, 900px);
    padding: 0;
    border: 1px solid var(--line);
    border-top: 3px solid var(--accent);
    background: var(--bg-2);
    color: var(--text);
    overflow: hidden;
  }
  .ml[open] { display: flex; flex-direction: column; animation: ml-in .25s var(--ease); }
  .ml::backdrop { background: rgba(3, 10, 14, .78); backdrop-filter: blur(4px); }
  @keyframes ml-in { from { opacity: 0; transform: translateY(12px); } }

  .ml-tete {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px clamp(18px, 4vw, 32px);
    border-bottom: 1px solid var(--line);
  }
  .ml-tete h2 { margin: 0; font-size: clamp(1.8rem, 5vw, 2.6rem); }
  .ml-tete em { color: var(--accent); font-style: normal; }
  .ml-fermer {
    all: unset;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: none;
    cursor: pointer;
    box-shadow: inset 0 0 0 1px var(--line);
    transition: background .2s, color .2s;
  }
  .ml-fermer:hover { background: var(--accent); color: var(--accent-ink); }
  .ml-fermer:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .ml-corps {
    overflow-y: auto;
    padding: 8px clamp(18px, 4vw, 32px) 28px;
    line-height: 1.65;
    color: var(--muted);
  }
  .ml-corps h3 {
    margin: 26px 0 8px;
    color: var(--accent);
    font-size: 1.25rem;
    text-transform: uppercase;
  }
  .ml-corps p { margin: 0 0 10px; }
  .ml-corps strong { color: var(--text); }
  .ml-corps a { color: var(--accent-2); }

  @media (prefers-reduced-motion: reduce) { .ml[open] { animation: none; } }
</style>
