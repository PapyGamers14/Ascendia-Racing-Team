---
import Logo from './Logo.astro';
import Social from './Social.astro';
import MentionsLegales from './MentionsLegales.astro';
const annee = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap">
    <div class="cols">
      <div>
        <Logo size={40} />
        <p class="tag">Team d'endurance virtuelle · iRacing</p>
        <MentionsLegales />
      </div>
      <nav aria-label="Pied de page">
        <p class="mono label">Navigation</p>
        <a href="/team">Team</a>
        <a href="/resultats">Résultats</a>
        <a href="/streams">Streams</a>
        <a href="/calendrier">Calendrier</a>
        <a href="/recrutement">Recrutement</a>
        <a href="/#reseaux">Nos réseaux</a>
      </nav>
      <div>
        <p class="mono label">Suivre la team</p>
        <Social />
        <a href="mailto:ascendia.racing@gmail.com" class="mail">
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18v14H3zM3 6l9 7 9-7" fill="none" stroke="currentColor" stroke-width="2" /></svg>
          ascendia.racing@gmail.com
        </a>
      </div>
    </div>
    <div class="legal mono">
      <span>© {annee} Ascendia Racing Team</span>
      <span>Box ouvert · Lap after lap</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg);
    padding-top: 36px;
  }
  .cols {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 36px;
  }
  .tag { color: var(--muted); max-width: 32ch; margin-top: 16px; }
  .label { color: var(--muted); margin: 0 0 14px; }
  /* liens de navigation sur deux colonnes (le titre « Navigation » prend toute la largeur) */
  nav { display: grid; grid-template-columns: repeat(2, max-content); column-gap: 40px; row-gap: 6px; align-content: start; }
  nav .label { grid-column: 1 / -1; }
  nav a { text-decoration: none; transition: color .2s; }
  nav a:hover { color: var(--accent); }
  .mail { display: inline-flex; align-items: center; gap: 8px; margin-top: 16px; color: var(--muted); text-decoration: none; transition: color .2s; }
  .mail:hover { color: var(--accent); }
  .legal {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding-block: 22px;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .cols { grid-template-columns: 1fr; }
  }
</style>
