---
import Logo from './Logo.astro';
import Social from './Social.astro';
import { siDiscord } from 'simple-icons';

// Lien d'invitation du serveur Discord de la team
const discordUrl = 'https://discord.gg/fwKemzCC7J';

const liens = [
  { href: '/', label: 'Accueil' },
  { href: '/team', label: 'Team' },
  { href: '/calendrier', label: 'Calendrier' },
];
const actuel = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="header">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="Ascendia Racing Team — accueil"><Logo /></a>

    <button class="burger" aria-expanded="false" aria-controls="menu" aria-label="Ouvrir le menu">
      <span></span><span></span>
    </button>

    <nav id="menu" class="menu" aria-label="Navigation principale">
      <ul>
        {liens.map((l, i) => (
          <li>
            <a href={l.href} aria-current={actuel === l.href ? 'page' : undefined}>
              <span class="idx">0{i + 1}</span>{l.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="menu-social"><Social /></div>
      <a href={discordUrl} class="btn discord" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={siDiscord.path} fill="currentColor" /></svg>
        Discord
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('.header');
  const burger = document.querySelector('.burger');
  burger?.addEventListener('click', () => {
    const open = header?.classList.toggle('open');
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
  });
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 20);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    transition: background .3s, border-color .3s;
    border-bottom: 1px solid transparent;
  }
  .header.scrolled {
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-color: var(--line);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 76px; }
  .brand { text-decoration: none; }

  .menu { display: flex; align-items: center; gap: 36px; }
  .menu ul { display: flex; gap: 28px; list-style: none; margin: 0; padding: 0; }
  .menu ul a {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 6px;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color .2s;
  }
  .idx { font-family: var(--font-mono); font-size: .6rem; color: var(--accent); }
  .menu ul a:hover, .menu ul a[aria-current] { color: var(--text); }
  .menu ul a[aria-current]::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -8px;
    height: 2px;
    background: var(--accent);
  }
  .menu-social { display: none; }
  .discord {
    padding: 10px 22px 10px 18px;
    font-size: 1rem;
    gap: 10px;
    background: #5865f2;   /* couleur officielle Discord */
    color: #fff;
  }
  .discord:hover { background: #4752c4; }

  .burger { display: none; }

  @media (max-width: 1080px) {
    .burger {
      display: grid;
      gap: 7px;
      width: 44px; height: 44px;
      place-content: center;
      background: none;
      border: 0;
      cursor: pointer;
      z-index: 2;
    }
    .burger span {
      display: block;
      width: 26px; height: 2px;
      background: var(--text);
      transition: transform .3s var(--ease);
    }
    .open .burger span:first-child { transform: translateY(4.5px) rotate(45deg); }
    .open .burger span:last-child { transform: translateY(-4.5px) rotate(-45deg); }

    .menu {
      position: fixed;
      inset: 0;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 40px;
      padding: 100px var(--gutter) 40px;
      background: var(--bg);
      clip-path: inset(0 0 100% 0);
      transition: clip-path .5s var(--ease);
    }
    .open .menu { clip-path: inset(0); }
    .menu ul { flex-direction: column; gap: 14px; }
    .menu ul a { font-size: 2.8rem; color: var(--text); }
    .idx { font-size: .8rem; }
    .menu ul a[aria-current]::after { display: none; }
    .menu ul a[aria-current] { color: var(--accent); }
    .menu-social { display: block; }
  }
</style>
