---
// Logos des simulateurs.
// iRacing : icône officielle (kit « iRacing Brandmarks 2022 », iracing.com/resources/logos).
// LMU : carré rouge « LM », redessiné en SVG.
import iracingIcone from '../assets/logos/iracing-icon.svg';

interface Props { jeu: 'iRacing' | 'LMU'; taille?: number }
const { jeu, taille = 40 } = Astro.props;
const ratioIracing = 486.12 / 371.8; // proportions de l'icône officielle
---
{jeu === 'iRacing' ? (
  <img
    class="logo-jeu"
    src={iracingIcone.src}
    width={Math.round(taille * ratioIracing)}
    height={taille}
    alt="iRacing"
  />
) : (
  <svg class="logo-jeu" width={taille} height={taille} viewBox="0 0 100 100" role="img" aria-label="Le Mans Ultimate">
    <title>Le Mans Ultimate</title>
    <rect width="100" height="100" rx="8" fill="#e8284a" />
    <g transform="translate(50 52) skewX(-14)" fill="#fff">
      <!-- L -->
      <path d="M-34 -16h10v24h14v8h-24z" />
      <!-- M -->
      <path d="M-6 -16h10l6 12 6-12h10v32h-9v-16l-7 12-7-12v16h-9z" />
    </g>
  </svg>
)}

<style>
  .logo-jeu { flex: none; display: block; filter: drop-shadow(0 4px 10px rgba(0, 0, 0, .35)); }
</style>
