---
// Portrait détouré (fond transparent) posé devant le drapeau de son pays.
// Le drapeau est dessiné par la page : aucune image à préparer par pays,
// tout nouveau membre avec un `pays` a automatiquement son drapeau en fond.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { drapeaux, type Pays } from '../data/pays';

interface Props {
  src: ImageMetadata;      // portrait détouré (PNG/WebP avec transparence)
  alt: string;
  pays?: Pays;             // sans pays : fond sombre avec halo cyan
  widths: number[];
  sizes: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}
const { src, alt, pays, widths, sizes, loading = 'lazy', class: classe } = Astro.props;
const d = pays ? drapeaux[pays] : undefined;
---
<div class:list={['portrait-drapeau', classe, { 'sans-drapeau': !d }]}>
  {d && (
    <svg class="pd-drapeau" viewBox="0 0 3 2" aria-hidden="true"
         preserveAspectRatio={'bandes' in d ? 'none' : 'xMidYMid slice'}>
      {'bandes' in d
        ? d.bandes.map((c, i) => <rect x={i} width="1.01" height="2" fill={c} />)
        : <Fragment set:html={d.dessin} />}
    </svg>
  )}
  <span class="pd-plis" aria-hidden="true"></span>
  <Image class="pd-img" src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} />
</div>

<style>
  .portrait-drapeau {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #061117;
  }
  /* sans pays : fond sombre avec un halo cyan, comme les portraits d'origine */
  .sans-drapeau { background: radial-gradient(60% 55% at 50% 45%, color-mix(in srgb, var(--accent) 35%, transparent), #061117 75%); }
  .pd-drapeau { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -2; }
  /* plis du drapeau + bords assombris pour se fondre dans le site */
  .pd-plis {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(0,0,0,.25), rgba(255,255,255,.08) 25%, rgba(0,0,0,.18) 50%, rgba(255,255,255,.06) 75%, rgba(0,0,0,.28)),
      radial-gradient(75% 75% at 50% 42%, transparent 45%, rgba(6,17,23,.75));
  }
  /* le pilote, avec une ombre douce qui le détache du drapeau */
  .pd-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: drop-shadow(0 16px 22px rgba(0, 0, 0, .55));
  }
</style>
