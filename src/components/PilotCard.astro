---
import type { CollectionEntry } from 'astro:content';
interface Props { pilote: CollectionEntry<'pilotes'>; delay?: number }
const { pilote, delay = 0 } = Astro.props;
const p = pilote.data;
const num = String(p.numero).padStart(2, '0');
---
<article class="card reveal" style={`--d:${delay}s`} data-jeux={p.jeux.join(' ')}>
  <div class="top">
    <span class="mono flag">{p.pays}</span>
    <span class="mono role">{p.role}</span>
  </div>

  <span class="num" aria-hidden="true">{num}</span>

  <div class="id">
    <p class="mono cat">{p.categorie}</p>
    <h3>{p.pseudo}</h3>
    <p class="nom">{p.nom} · <span class="mono">#{num}</span></p>
  </div>

  {pilote.body && <p class="bio">{pilote.body.trim()}</p>}

  <dl class="data">
    {p.irating && <div><dt>iRating</dt><dd>{p.irating.toLocaleString('fr-FR')}</dd></div>}
    {p.licence && <div><dt>Licence</dt><dd>{p.licence}</dd></div>}
    {p.lmuRating && <div><dt>LMU</dt><dd>{p.lmuRating}</dd></div>}
  </dl>

  <ul class="jeux">
    {p.jeux.map((j) => <li class="mono">{j}</li>)}
  </ul>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-height: 420px;
    padding: 24px;
    background: var(--bg-2);
    border: 1px solid var(--line);
    overflow: hidden;
    isolation: isolate;
    transition: border-color .3s, transform .4s var(--ease);
  }
  /* bande diagonale qui "monte" au survol */
  .card::before {
    content: "";
    position: absolute;
    inset: -40% -60%;
    z-index: -1;
    background: linear-gradient(115deg, transparent 45%, color-mix(in srgb, var(--accent) 16%, transparent) 45%, color-mix(in srgb, var(--accent) 16%, transparent) 55%, transparent 55%);
    transform: translateY(60%);
    transition: transform .7s var(--ease);
  }
  .card:hover { border-color: var(--accent); }
  .card:hover::before { transform: translateY(-10%); }

  .top { display: flex; justify-content: space-between; color: var(--muted); }
  .flag { color: var(--text); padding: 2px 8px; box-shadow: inset 0 0 0 1px var(--line); }

  .num {
    position: absolute;
    top: 42px;
    right: 14px;
    z-index: -1;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 9rem;
    line-height: .8;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--line);
    transition: -webkit-text-stroke-color .3s;
  }
  .card:hover .num { -webkit-text-stroke-color: var(--accent); }

  .id { margin-top: auto; }
  .cat { color: var(--accent); margin: 0 0 6px; }
  h3 { font-size: 3.4rem; }
  .nom { margin: 6px 0 0; color: var(--muted); font-size: .95rem; }

  .bio { margin: 0; font-size: .92rem; color: var(--muted); }

  .data {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));
    gap: 1px;
    margin: 0;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .data div { background: var(--bg-2); padding: 10px 12px; }
  dt { font-family: var(--font-mono); font-size: .62rem; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  dd { margin: 2px 0 0; font-family: var(--font-mono); font-weight: 600; font-size: .9rem; }

  .jeux { display: flex; gap: 6px; list-style: none; margin: 0; padding: 0; }
  .jeux li { padding: 4px 10px; background: var(--bg-3); font-size: .68rem; }
</style>
