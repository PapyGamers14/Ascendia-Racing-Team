---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Drapeau from '../components/Drapeau.astro';
import { membres, groupes, photoDe, type Membre } from '../data/team';

const nomComplet = (m: Membre) => [m.prenom, m.nom].filter(Boolean).join(' ');
const altDe = (m: Membre) =>
  m.photo ? `${nomComplet(m)}, ${m.role}, en combinaison Ascendia Racing` : `Avatar pilote Ascendia Racing casqué, pour ${nomComplet(m)}`;

const parGroupe = groupes
  .map((g) => ({ ...g, liste: membres.filter((m) => m.groupe === g.id) }))
  .filter((g) => g.liste.length > 0);
const fondateurs = parGroupe.find((g) => g.id === 'fondateur');
const grilles = parGroupe.filter((g) => g.id !== 'fondateur');
---
<Base title="Team" description="La team Ascendia Racing : les fondateurs Damien Wuilmus et Antoine Barbosa, le staff, pilotes compétition et pilotes de l'académie du club de simracing d'endurance sur iRacing.">
  <PageHero
    index="02"
    kicker="Ascendia Racing"
    titre="La "
    accent="team"
    intro={`${membres.length} membres, un seul casque : fondateurs, staff, pilotes compétition et académie font vivre le club, relais après relais.`}
  />

  <!-- sommaire de la page -->
  <nav class="wrap sommaire" aria-label="Sections de la team">
    {parGroupe.map((g) => (
      <a href={`#${g.id}`}>
        <strong>{g.liste.length}</strong>
        <span class="mono">{g.accent}</span>
      </a>
    ))}
  </nav>

  <!-- ================= FONDATEURS : grandes fiches côte à côte ================= -->
  {fondateurs && (
    <section id="fondateur" class="wrap bloc" aria-labelledby="t-fondateur">
      <div class="section-head">
        <div>
          <p class="kicker">{fondateurs.kicker}</p>
          <h2 id="t-fondateur">{fondateurs.titre}<em>{fondateurs.accent}</em></h2>
        </div>
      </div>
      <div class="duo">
      {fondateurs.liste.map((m, i) => (
        <article class="fiche reveal" style={`--d:${i * 0.12}s`}>
          <div class="portrait">
            <Image src={photoDe(m)} alt={altDe(m)} widths={[400, 700, 1024]} sizes="(max-width: 860px) 90vw, 560px" loading="eager" />
          </div>
          <div class="infos">
            {m.pays && <span class="f-drapeau"><Drapeau pays={m.pays} taille={60} /></span>}
            <p class="kicker">{m.role}</p>
            <h3>
              <span class="prenom">{m.prenom}</span>
              <span class="nom">{m.nom}</span>
            </h3>
          </div>
        </article>
      ))}
      </div>
    </section>
  )}

  <!-- ================= STAFF / COMPÉTITION / ACADÉMIE : grilles de cartes ================= -->
  {grilles.map((g) => (
    <section id={g.id} class:list={['wrap', 'bloc', g.id]} aria-labelledby={`t-${g.id}`}>
      <div class="section-head">
        <div>
          <p class="kicker">{g.kicker}</p>
          <h2 id={`t-${g.id}`}>{g.titre}<em>{g.accent}</em></h2>
        </div>
        <p class="mono compte">{g.liste.length} membres</p>
      </div>
      <ul class="grille">
        {g.liste.map((m, i) => (
          <li class="carte reveal" style={`--d:${(i % 5) * 0.05}s`}>
            <div class="carte-img">
              <Image src={photoDe(m)} alt={altDe(m)} widths={[300, 500]} sizes="(max-width: 600px) 45vw, 240px" />
            </div>
            <div class="carte-txt">
              {m.pays && <span class="c-drapeau"><Drapeau pays={m.pays} taille={34} /></span>}
              <p class="mono role">{m.role}</p>
              <h3>
                {m.prenom && <span class="c-prenom">{m.prenom}</span>}
                <em class="c-nom">{m.nom}</em>
              </h3>
              <p class="mono jeux">
                {m.groupe === 'staff' && m.pilote && <span class="tag">Pilote</span>}
                {m.jeux.join(' · ')}
              </p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>

<style>
  /* ---------- SOMMAIRE ---------- */
  .sommaire {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    margin-top: clamp(40px, 6vw, 64px);
    background: var(--line);
    border: 1px solid var(--line);
  }
  .sommaire a {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 18px 20px;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    text-decoration: none;
    transition: background .2s;
  }
  .sommaire a:hover { background: var(--bg-3); }
  .sommaire strong { font-family: var(--font-display); font-weight: 900; font-size: 2.6rem; line-height: 1; color: var(--accent); }
  .sommaire .mono { color: var(--muted); }

  .bloc { padding-top: clamp(64px, 9vw, 120px); }
  .bloc:last-of-type { padding-bottom: clamp(64px, 9vw, 120px); }
  .compte { color: var(--muted); }

  /* ---------- FICHES FONDATEURS ---------- */
  /* les fondateurs côte à côte, chacun en carte verticale */
  .duo {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(20px, 4vw, 48px);
  }
  .fiche { display: flex; flex-direction: column; }
  .infos { padding-top: 24px; }

  /* halo cyan derrière le portrait, comme un projecteur de paddock */
  .portrait { position: relative; isolation: isolate; }
  .portrait::before {
    content: "";
    position: absolute;
    inset: 8% 4% 4%;
    z-index: -1;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 45%, transparent), transparent);
    filter: blur(40px);
  }
  .portrait :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;          /* cadrage de la tête à la taille */
    object-fit: cover;
    object-position: 50% 6%;
    border: 1px solid var(--line);
    border-top: 2px solid var(--accent);
    box-shadow: 0 40px 80px rgba(0, 0, 0, .5);
  }
  .infos h3 { margin: 14px 0 0; }
  .prenom { display: block; min-height: 1em; font-size: clamp(1.8rem, 3vw, 2.6rem); color: var(--accent); }
  /* drapeau calé sous le coin inférieur droit du portrait */
  .infos { position: relative; }
  .f-drapeau { position: absolute; top: 24px; right: 0; display: flex; }
  .nom { display: block; font-size: clamp(2.8rem, 5.6vw, 4.8rem); line-height: .85; }

  /* ---------- GRILLES DE CARTES ---------- */
  .grille {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 14px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .staff .grille { grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  .carte {
    display: flex;
    flex-direction: column;
    background: color-mix(in srgb, var(--bg-2) 90%, transparent);
    border: 1px solid var(--line);
    overflow: hidden;
    transition: border-color .3s, transform .3s var(--ease);
  }
  .carte:hover { border-color: var(--accent); transform: translateY(-4px); }
  .carte-img {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: radial-gradient(60% 60% at 50% 45%, color-mix(in srgb, var(--accent) 25%, transparent), transparent);
  }
  .carte-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 12%;
    transition: transform .6s var(--ease);
  }
  .carte:hover .carte-img :global(img) { transform: scale(1.05); }
  /* drapeau calé sous le coin inférieur droit de la photo */
  .carte-txt { position: relative; }
  .c-drapeau { position: absolute; top: 14px; right: 16px; display: flex; }
  .carte-txt .role, .c-prenom, .c-nom { display: block; padding-right: 44px; }
  .carte-txt { padding: 14px 16px 16px; border-top: 2px solid var(--accent); }
  .academie .carte-txt { border-top-color: var(--accent-2); }
  .role { margin: 0; color: var(--accent); font-size: .62rem; }
  .academie .role { color: var(--accent-2); }
  .carte h3 { margin: 8px 0 0; font-size: 1.5rem; line-height: 1; }
  .carte h3 .c-prenom { font-size: .8em; color: var(--muted); }
  .carte h3 .c-nom { font-style: normal; }
  .jeux { display: flex; align-items: center; gap: 8px; margin: 10px 0 0; color: var(--muted); font-size: .62rem; }
  .tag { padding: 2px 6px; box-shadow: inset 0 0 0 1px var(--line); color: var(--text); }

  @media (max-width: 860px) {
    .sommaire { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .duo { grid-template-columns: 1fr; }
    .grille, .staff .grille { grid-template-columns: 1fr 1fr; gap: 10px; }
    .carte h3 { font-size: 1.2rem; }
  }
</style>
