---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Drapeau from '../components/Drapeau.astro';
import { courses, type Equipage } from '../data/resultats';
import { plage } from '../data/courses';
import { siInstagram } from 'simple-icons';

const instagram = 'https://www.instagram.com/ascendiaracingteam/';

// On n'affiche que les 3 dernières courses (les plus récentes d'abord)
const NB_COURSES = 3;
const liste = [...courses].sort((a, b) => b.fin.localeCompare(a.fin)).slice(0, NB_COURSES);
const tous = liste.flatMap((c) => c.equipages);

// équipages présents, pour les filtres
const equipes = [...new Set(tous.map((e) => e.equipe).filter(Boolean))] as string[];

const podium = (p: Equipage['position']) => (p === 'DNF' ? 'dnf' : p === 1 ? 'or' : p === 2 ? 'argent' : p === 3 ? 'bronze' : '');
const posTexte = (p: Equipage['position']) => (p === 'DNF' ? 'DNF' : `P${p}`);
// titre de la carte : l'équipage, ou le pilote pour une course en solo
const titre = (e: Equipage) => (e.equipe ? `Équipage ${e.equipe}` : (e.pilotes ?? []).map((p) => p.nom).join(' · '));
---
<Base title="Résultats" description="Derniers résultats de l'Ascendia Racing Team sur iRacing : I-FRN Rookie Series, Suzuka 1000km, 24 Heures du Mans. Victoires et podiums des équipages Blaze, Astra, Comète et Academy.">
  <PageHero
    index="03"
    kicker="Saison 2026"
    titre="Nos derniers "
    accent="résultats"
    intro="Chaque affiche raconte un relais de nuit, un arrêt aux stands bien timé ou une remontée dans le trafic."
  />

  <section class="section wrap">
    <!-- lien vers tous les résultats publiés sur Instagram -->
    <a class="insta" href={instagram} target="_blank" rel="noopener noreferrer">
      <span class="insta-icone" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="26" height="26"><path d={siInstagram.path} fill="currentColor" /></svg>
      </span>
      <span class="insta-txt">
        <strong>Retrouvez tous nos résultats ici</strong>
        <span class="mono">Sur Instagram · @ascendiaracingteam</span>
      </span>
      <svg class="insta-fleche" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2.4" /></svg>
      <span class="sr-only">(s'ouvre dans un nouvel onglet)</span>
    </a>

    <div class="filters" role="group" aria-label="Filtrer par équipage">
      <button class="mono" data-filtre="tous" aria-pressed="true">Tous les équipages</button>
      {equipes.map((e) => <button class="mono" data-filtre={e} aria-pressed="false">{e}</button>)}
    </div>

    <!-- ================= COURSES ================= -->
    {liste.map((c) => (
      <article class="course" data-course>
        <header class="course-head">
          <div>
            <p class="mono meta">{plage(c.debut, c.fin)} 2026 · {c.circuit}</p>
            <h2>{c.nom}</h2>
          </div>
          <div class="etiquettes">
            {c.note && <span class="mono serie note">{c.note}</span>}
            {c.serie && <span class="mono serie">{c.serie}</span>}
          </div>
        </header>

        <ul class="equipages">
          {c.equipages.map((e, i) => (
            <li class:list={['carte', 'reveal', podium(e.position)]} style={`--d:${i * 0.08}s`} data-equipe={e.equipe ?? ''}>
              <a class="affiche" href={e.affiche.src} target="_blank" rel="noopener" aria-label={`Voir l'affiche ${c.nom} — ${titre(e)} en grand`}>
                <Image
                  src={e.affiche}
                  alt={`Affiche ${c.nom} : ${titre(e)}, ${posTexte(e.position)}${e.split ? `, split ${e.split}` : ''}${e.pilotes ? `, pilotes ${e.pilotes.map((p) => p.nom).join(', ')}` : ''}`}
                  widths={[400, 700]}
                  sizes="(max-width: 700px) 90vw, 380px"
                />
              </a>
              <div class="infos">
                <div class="ligne-1">
                  <span class="mono equipe">{titre(e)}{!e.equipe && e.pilotes?.[0]?.pays && <Drapeau pays={e.pilotes[0].pays} taille={20} />}</span>
                  <span class="mono cat">{e.categorie}</span>
                </div>
                <div class="ligne-2">
                  <strong class="pos">{posTexte(e.position)}</strong>
                  {e.split && <span class="mono split">Split<b>{e.split}</b></span>}
                </div>
                <p class="voiture">{e.voiture}</p>
              </div>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </section>
</Base>

<script>
  const boutons = document.querySelectorAll<HTMLButtonElement>('[data-filtre]');
  const cartes = document.querySelectorAll<HTMLElement>('[data-equipe]');
  const blocs = document.querySelectorAll<HTMLElement>('[data-course]');
  boutons.forEach((b) => b.addEventListener('click', () => {
    const f = b.dataset.filtre!;
    boutons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    cartes.forEach((c) => { c.hidden = f !== 'tous' && c.dataset.equipe !== f; });
    // une course sans équipage visible disparaît
    blocs.forEach((bl) => { bl.hidden = !bl.querySelector('[data-equipe]:not([hidden])'); });
  }));
</script>

<style>
  /* ---------- LIEN INSTAGRAM ---------- */
  .insta {
    display: flex;
    align-items: center;
    gap: 18px;
    max-width: 560px;
    margin-bottom: 32px;
    padding: 16px 20px;
    background: color-mix(in srgb, var(--bg-2) 90%, transparent);
    border: 1px solid var(--line);
    border-left: 3px solid #e1306c;
    text-decoration: none;
    transition: border-color .3s, transform .3s var(--ease), background .3s;
  }
  .insta:hover { border-color: #e1306c; background: color-mix(in srgb, #e1306c 12%, var(--bg-2)); transform: translateX(4px); }
  /* dégradé officiel Instagram sur l'icône */
  .insta-icone {
    display: grid;
    place-items: center;
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    color: #fff;
    background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285aeb 90%);
  }
  .insta-txt { display: flex; flex-direction: column; gap: 4px; flex: 1; }
  .insta-txt strong { font-family: var(--font-display); font-weight: 800; font-size: 1.5rem; text-transform: uppercase; line-height: 1; }
  .insta-txt .mono { color: var(--muted); font-size: .66rem; }
  .insta-fleche { flex: none; color: var(--muted); transition: transform .3s var(--ease), color .3s; }
  .insta:hover .insta-fleche { color: #fff; transform: translate(3px, -3px); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* ---------- FILTRES ---------- */
  .filters { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 8px; }
  .filters button {
    padding: 10px 18px;
    background: transparent;
    color: var(--muted);
    border: 1px solid var(--line);
    cursor: pointer;
    transition: color .2s, background .2s, border-color .2s;
  }
  .filters button:hover { color: var(--text); border-color: var(--text); }
  .filters button[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }

  /* ---------- COURSE ---------- */
  .course { margin-top: clamp(48px, 7vw, 80px); }
  .course[hidden], .carte[hidden] { display: none; }
  .course-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    flex-wrap: wrap;
    padding-bottom: 16px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--line);
  }
  .meta { margin: 0 0 6px; color: var(--accent); }
  .course-head h2 { font-size: clamp(2.4rem, 6vw, 4.4rem); }
  .etiquettes { display: flex; flex-wrap: wrap; gap: 8px; }
  .serie { padding: 6px 12px; color: var(--muted); box-shadow: inset 0 0 0 1px var(--line); }
  .serie.note { color: var(--accent-2); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 40%, transparent); }

  /* ---------- CARTES D'ÉQUIPAGE ---------- */
  .equipages {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 18px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .carte {
    --pos: var(--line);
    display: flex;
    flex-direction: column;
    background: color-mix(in srgb, var(--bg-2) 90%, transparent);
    border: 1px solid var(--line);
    border-top: 3px solid var(--pos);
    overflow: hidden;
    transition: transform .3s var(--ease), border-color .3s;
  }
  .carte:hover { transform: translateY(-4px); border-color: var(--pos); }
  /* podiums : or, argent, bronze */
  .carte.or { --pos: #f2c14e; }
  .carte.argent { --pos: #c9d6dc; }
  .carte.bronze { --pos: #d08a4f; }

  .affiche { display: block; overflow: hidden; aspect-ratio: 4 / 5; }
  .affiche :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
  .carte:hover .affiche :global(img) { transform: scale(1.04); }

  .infos { display: flex; flex-direction: column; gap: 10px; padding: 18px 20px 20px; }
  .ligne-1 { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .equipe { display: flex; align-items: center; gap: 8px; color: var(--accent); }
  .cat { padding: 3px 8px; font-size: .6rem; color: var(--accent-2); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 40%, transparent); }
  .ligne-2 { display: flex; align-items: center; gap: 16px; }
  .pos { font-family: var(--font-display); font-weight: 900; font-size: 3.6rem; line-height: .85; }
  .or .pos, .argent .pos, .bronze .pos, .dnf .pos { color: var(--pos); }
  /* abandon : rouge, comme sur l'affiche */
  .carte.dnf { --pos: #e5484d; }
  .split { display: flex; flex-direction: column; color: var(--muted); font-size: .6rem; }
  .split b { font-family: var(--font-display); font-size: 1.5rem; color: var(--text); letter-spacing: 0; }
  .voiture { display: flex; align-items: baseline; gap: 10px; margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; text-transform: uppercase; }
</style>
